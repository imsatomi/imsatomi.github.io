---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | where_exp: "p", "p.url != '/404.html' and p.url != '/sitemap.xml' and p.url != '/robots.txt'" %}
{%- for p in pages %}{% unless p.url contains '.css' or p.url contains '.js' %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- endunless %}{% endfor %}
{%- for p in site.projects %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
